{
  "name": "turbo-r2-queue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run lint && npm run format:check && wrangler deploy --dry-run && tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "^24.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "4.124.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run format:check && npm run types && npx tsc --noEmit",
    "commit-msg": "npx --no -- commitlint --edit \"$1\""
  },
  "allowScripts": {
    "workerd@1.20260825.1": true,
    "workerd@1.20260815.1": true,
    "esbuild@0.28.1": true,
    "simple-git-hooks@2.14.0": true
  }
}
