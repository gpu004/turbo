    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run audit && wrangler deploy --dry-run",
    "test": "vitest run",
    "types": "wrangler types"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@oxlint/plugins": "1.80.0",
    "@types/node": "^24.3.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "4.149.0"
  }
}
